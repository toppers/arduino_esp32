  "_releaseArtifactsComment": "a release is three kinds of artifact, not one. The platform archive carries the board definition, the prebuilt stages and the bundled library; the link driver is a separate Arduino tool frozen once per host, because a sketch build needs it and no package index ships a Python interpreter. scripts/check_release_artifacts.py verifies an assembled release against this section before it is published.",
  "releaseArtifacts": {
    "platformArchive": {
      "kind": "platform",
      "architecture": "esp32",
      "fileNamePattern": "toppers-esp32-{version}.zip"
    },
    "linkDriver": {
      "kind": "tool",
      "toolName": "fmp3-link",
      "fileNamePattern": "fmp3-link-{host}.zip",
      "driverSource": "scripts/fmp3_link.py",
      "_hostsComment": "Arduino host triplets a release must carry a frozen driver for. x86_64-apple-darwin is absent on purpose: the macos-13 runner stopped being allocated, and a queued job hangs rather than fails, so it would stall the release. Intel Macs cannot build with 0.3.0. Add the host back here and in both workflows once a working Intel label exists.",
      "hosts": [
        "x86_64-mingw32",
        "x86_64-pc-linux-gnu",
        "arm64-apple-darwin"
      ]
    },
    "packageIndex": {
      "kind": "index",
      "fileNamePattern": "package_toppers_index.json"
    }
  }
